# ==============================
# 排除所有 . 开头的文件和文件夹
# ==============================
.*
# 白名单：需要提交的 dot 文件
!.gitignore
!.gitattributes
!.editorconfig

# 编译输出
main.js
*.js.map

# Node 模块
node_modules/

# 操作系统文件
Thumbs.db

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时文件
*.tmp
*.temp

# 构建输出
dist/
build/
release/

