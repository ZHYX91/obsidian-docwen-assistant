{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "useDefineForClassFields": false,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts"
  ]
}
