* text=auto

# Release inputs and all build-relevant source text must have identical bytes
# on Windows and Linux.  In particular, the workflow embeds the reviewed
# publication-boundary.py bytes and verifies their SHA-256 before execution.
*.css text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.node-version text eol=lf
LICENSE text eol=lf
