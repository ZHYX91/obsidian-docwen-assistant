{
  "name": "docwen-assistant",
  "version": "1.2.0",
  "description": "Obsidian plugin for launching DocWen converter with current file path",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/main.js --platform=node --external:obsidian --watch",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --outfile=dist/main.js --platform=node --external:obsidian --external:electron --external:@electron/remote --minify",
    "build:quick": "esbuild src/main.ts --bundle --outfile=dist/main.js --platform=node --external:obsidian --external:electron --external:@electron/remote",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "clean": "if exist dist rmdir /s /q dist && if exist release rmdir /s /q release",
    "prebuild": "if not exist dist mkdir dist",
    "version": "node version-bump.js && git add manifest.json versions.json",
    "release": "node scripts/build.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "docwen",
    "document",
    "converter"
  ],
  "author": "ZhengYX",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "esbuild": "^0.25.11",
    "eslint": "^9.36.0",
    "obsidian": "^1.10.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZHYX91/docwen-obsidian.git"
  }
}
